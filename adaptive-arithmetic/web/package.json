{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/domain.test.ts tests/sessionRecovery.test.ts tests/standard.test.ts tests/explorer.test.ts tests/optiver.test.ts",
    "test:optiver": "node tests/optiver-browser.mjs",
    "test:explorer": "node tests/explorer-browser.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:regressions": "node tests/review-regressions.mjs",
    "test:exports": "node tests/exports-browser.mjs",
    "test:stage1": "node tests/stage1-browser.mjs",
    "test:review-fixes": "node tests/review-fixes-browser.mjs",
    "test:improvements": "node tests/improvements-browser.mjs",
    "test:next-improvements": "node tests/next-improvements-browser.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-icons": "^5.7.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "prettier": "^3.6.2",
    "puppeteer-core": "^24.16.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
